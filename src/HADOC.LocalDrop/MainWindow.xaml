<Window x:Class="HADOC.LocalDrop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HADOC LocalDrop" Height="820" Width="1220"
        MinHeight="700" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="#080B11" Foreground="#F3F6FA"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#121923"/>
        <SolidColorBrush x:Key="PanelLineBrush" Color="#273346"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8795A8"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F8FAFD"/>
            <Setter Property="Background" Value="#202B3B"/>
            <Setter Property="BorderBrush" Value="#35445A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Background" Value="#0C121B"/>
            <Setter Property="BorderBrush" Value="#35445A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="#EAF0F7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Background" Value="#0C121B"/>
            <Setter Property="BorderBrush" Value="#35445A"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="46" Height="46" CornerRadius="14" Background="#E54852" Margin="0,0,13,0">
                    <TextBlock Text="LD" Foreground="White" FontSize="17" FontWeight="ExtraBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="HADOC LocalDrop" FontSize="22" FontWeight="Bold" LetterSpacing="-0.5"/>
                    <TextBlock Text="PC  ↔  MOBILE     /     DIRECT LOCAL TRANSFER"
                               Foreground="#8492A5" FontSize="9" Margin="1,4,0,0"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="#10251D" BorderBrush="#28523D" BorderThickness="1"
                    CornerRadius="20" Padding="13,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#54D49A" Margin="0,0,8,0"/>
                    <TextBlock Text="NO CLOUD  ·  PRIVATE LAN" Foreground="#A1E8C5"
                               FontSize="9" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Pairing is the only screen shown until the phone connects. -->
        <Grid x:Name="ConnectPanel" Grid.Row="1">
            <Border Width="850" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#121923" BorderBrush="#2B374A" BorderThickness="1"
                    CornerRadius="24" Padding="30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="18" Padding="13"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="252" Height="252">
                            <Image x:Name="QrImage" Stretch="Uniform"/>
                            <StackPanel x:Name="QrPlaceholder" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Width="210">
                                <TextBlock Text="QR" Foreground="#D8DEE8" FontSize="52"
                                           FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Start LocalDrop to create your private pairing code"
                                           Foreground="#8793A4" FontSize="11" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28,0,0,0">
                        <TextBlock Text="YOUR PERSONAL FILE BRIDGE" Foreground="#F07980"
                                   FontSize="10" FontWeight="Bold" CharacterSpacing="1.5"/>
                        <TextBlock Text="Connect your phone." FontSize="29" FontWeight="Bold"
                                   Margin="0,11,0,0"/>
                        <TextBlock Text="Scan the QR code to open your private LocalDrop workspace. No phone app or internet connection is needed."
                                   Foreground="#9AA8B9" FontSize="12" TextWrapping="Wrap"
                                   LineHeight="21" Margin="0,8,0,0"/>
                        <Border Background="#0D141E" BorderBrush="#29364A" BorderThickness="1"
                                CornerRadius="12" Padding="13" Margin="0,22,0,0">
                            <StackPanel>
                                <TextBlock Text="NETWORK TO USE" Foreground="#8492A5"
                                           FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ComboBox x:Name="AddressBox" Height="38"
                                          SelectionChanged="AddressBox_SelectionChanged"/>
                                <TextBlock x:Name="UrlText" Text="Choose the network shared with your phone."
                                           Foreground="#95A3B6" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,17,0,0">
                            <Button x:Name="StartStopButton" Content="Start LocalDrop"
                                    Click="StartStop_Click" Background="#E54852" BorderBrush="#E54852"
                                    Padding="22,13" FontSize="13"/>
                            <Button Content="Copy link" Click="CopyLink_Click"
                                    Margin="9,0,0,0" Padding="17,13"/>
                        </StackPanel>
                        <TextBlock Text="Same Wi-Fi or hotspot · Internet not required"
                                   Foreground="#738197" FontSize="10" Margin="0,15,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- One unified workspace after pairing: chat, received files, shared files and one composer. -->
        <Grid x:Name="WorkspacePanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="78"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="4,0,4,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CONNECTED DEVICE" Foreground="#F07980"
                               FontSize="9" FontWeight="Bold" CharacterSpacing="1.4"/>
                    <TextBlock x:Name="ConnectedDeviceText" Text="Mobile phone"
                               FontSize="21" FontWeight="Bold" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#10251D" BorderBrush="#28523D" BorderThickness="1"
                            CornerRadius="18" Padding="11,7" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#54D49A" Margin="0,0,7,0"/>
                            <TextBlock x:Name="ConnectionStatusText" Text="LIVE"
                                       Foreground="#A1E8C5" FontSize="9" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Disconnect" Click="Disconnect_Click"
                            Background="#2B1B24" BorderBrush="#63323F" Foreground="#FF9BA0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*"/>
                    <ColumnDefinition Width="0.85*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#121923" BorderBrush="#273346"
                        BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,9,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="2,0,0,12">
                            <TextBlock Text="LOCAL CHAT" Foreground="#F07980"
                                       FontSize="9" FontWeight="Bold" CharacterSpacing="1.4"/>
                            <TextBlock Text="Your conversation" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ListBox x:Name="ChatList" Grid.Row="1" ItemsSource="{Binding ChatMessages}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A2432" BorderBrush="#2B394D" BorderThickness="1"
                                            CornerRadius="12" Padding="12" Margin="0,0,0,2">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Sender}" Foreground="#F07980"
                                                           FontSize="9" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SentAt, StringFormat={}{0:HH:mm}}"
                                                           Foreground="#738197" FontSize="9" DockPanel.Dock="Right"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Text}" Foreground="#E8EEF6"
                                                       FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                    <Border Background="#121923" BorderBrush="#273346" BorderThickness="1"
                            CornerRadius="18" Padding="15" Height="*">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel Margin="1,0,1,10">
                                <TextBlock Text="RECEIVED ON PC" Foreground="#F07980"
                                           FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Content="Open folder" Click="OpenReceiveFolder_Click"
                                        DockPanel.Dock="Right" FontSize="9" Padding="9,6"/>
                            </DockPanel>
                            <ListBox x:Name="ReceivedFilesList" Grid.Row="1" ItemsSource="{Binding ReceivedFiles}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#101A20" BorderBrush="#244537" BorderThickness="1"
                                                CornerRadius="9" Padding="9">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="#E5F4EC"
                                                           FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DisplayText}" Foreground="#82B69C"
                                                           FontSize="8" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Background="#121923" BorderBrush="#273346" BorderThickness="1"
                            CornerRadius="18" Padding="15" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="READY TO SEND" Foreground="#F07980"
                                       FontSize="9" FontWeight="Bold" Margin="1,0,0,9"/>
                            <ListBox x:Name="SharedFilesList" Grid.Row="1" ItemsSource="{Binding SharedFiles}"
                                     MaxHeight="120">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1A2432" BorderBrush="#2B394D" BorderThickness="1"
                                                CornerRadius="8" Padding="8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="#E8EEF6"
                                                           FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DisplayName}" Foreground="#8392A6"
                                                           FontSize="8" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,13,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ChatInput" Height="48" VerticalContentAlignment="Center"
                         KeyDown="ChatInput_KeyDown" ToolTip="Type a message and press Enter"
                         Text=""/>
                <Button Grid.Column="1" Content="Send" Click="SendChat_Click"
                        Background="#273449" BorderBrush="#3C4B62" Margin="9,0,0,0" Padding="20,12"/>
                <Button Grid.Column="2" Content="+  Add files" Click="AddFiles_Click"
                        Background="#E54852" BorderBrush="#E54852" Margin="9,0,0,0"
                        Padding="22,12" FontSize="13"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="4,8,4,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready · Start LocalDrop to show the connection QR."
                       Foreground="#718096" FontSize="9" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="HADOC  /  KyZer_HADOC"
                       Foreground="#526075" FontSize="9" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
