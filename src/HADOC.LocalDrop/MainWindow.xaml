<Window x:Class="HADOC.LocalDrop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HADOC LocalDrop" Icon="pack://application:,,,/Assets/HADOC-LocalDrop.ico"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        ResizeMode="CanResize" MinWidth="980" MinHeight="660"
        Background="#080A10" Foreground="#F4F6FB" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#F0525D"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#202B3C"/>
            <Setter Property="BorderBrush" Value="#36445A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F4F6FB"/>
            <Setter Property="Background" Value="#0B1018"/>
            <Setter Property="BorderBrush" Value="#303D51"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionBrush" Value="#803B465D"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="#EAF0F8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,8"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4F6FB"/>
            <Setter Property="Background" Value="#0B1018"/>
            <Setter Property="BorderBrush" Value="#344257"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0D121B" BorderBrush="#222D3D"
                BorderThickness="1" CornerRadius="18" Padding="16,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="14" Background="#090B10"
                            BorderBrush="#71303A" BorderThickness="1" Padding="2" Margin="0,0,13,0">
                        <Image Source="pack://application:,,,/Assets/HADOC-LocalDrop.ico" Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="HADOC LocalDrop" FontSize="21" FontWeight="Bold" Foreground="#F7F8FC"/>
                        <TextBlock Text="PC  ↔  MOBILE     /     FAST LOCAL SHARING"
                                   Foreground="#8492A6" FontSize="9" Margin="1,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#10251E" BorderBrush="#28523E"
                        BorderThickness="1" CornerRadius="20" Padding="13,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#55D69D" Margin="0,0,8,0"/>
                        <TextBlock Text="NO CLOUD  ·  PRIVATE LAN" Foreground="#A5E8C7"
                                   FontSize="9" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="ConnectPanel" Grid.Row="1">
            <Border MaxWidth="1050" MinHeight="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#111722" BorderBrush="#2A3548" BorderThickness="1"
                    CornerRadius="25" Padding="30">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="10" Opacity="0.32"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="20" Padding="15"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="276" Height="276">
                            <Image x:Name="QrImage" Stretch="Uniform"/>
                            <StackPanel x:Name="QrPlaceholder" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Width="220">
                                <TextBlock Text="QR" Foreground="#D6DCE5" FontSize="58" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Start LocalDrop to generate your private pairing code"
                                           Foreground="#7E8999" FontSize="11" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="32,0,14,0">
                        <TextBlock Text="YOUR PRIVATE FILE BRIDGE" Foreground="#FF7880"
                                   FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="Connect your phone." FontSize="34" FontWeight="Bold" Margin="0,12,0,0"/>
                        <TextBlock Text="Scan the QR code with your phone camera. Your browser opens a private workspace for chat and file sharing."
                                   Foreground="#A1AEC0" FontSize="13" TextWrapping="Wrap"
                                   LineHeight="22" Margin="0,10,0,0" MaxWidth="540"/>
                        <Border Background="#0B111A" BorderBrush="#2A374A" BorderThickness="1"
                                CornerRadius="14" Padding="15" Margin="0,25,0,0">
                            <StackPanel>
                                <TextBlock Text="NETWORK SHARED WITH YOUR PHONE" Foreground="#8492A6"
                                           FontSize="9" FontWeight="Bold" Margin="0,0,0,9"/>
                                <ComboBox x:Name="AddressBox" Height="42"
                                          SelectionChanged="AddressBox_SelectionChanged"/>
                                <TextBlock x:Name="UrlText" Text="Choose the Wi-Fi or hotspot address for your phone."
                                           Foreground="#98A6B8" FontSize="10" TextWrapping="Wrap"
                                           Margin="1,9,1,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,19,0,0">
                            <Button x:Name="StartStopButton" Content="Start LocalDrop" Click="StartStop_Click"
                                    Background="#F0525D" BorderBrush="#F0525D" Padding="24,14" FontSize="13"/>
                            <Button Content="Copy link" Click="CopyLink_Click" Margin="10,0,0,0" Padding="19,14"/>
                        </StackPanel>
                        <TextBlock Text="Same Wi-Fi / hotspot · Internet is not required"
                                   Foreground="#738197" FontSize="10" Margin="0,16,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="WorkspacePanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="112"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="6,0,6,13">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CONNECTED DEVICE" Foreground="#F07980" FontSize="9" FontWeight="Bold"/>
                    <TextBlock x:Name="ConnectedDeviceText" Text="Mobile phone" FontSize="22"
                               FontWeight="Bold" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#10251E" BorderBrush="#28523E" BorderThickness="1"
                            CornerRadius="18" Padding="12,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#55D69D" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ConnectionStatusText" Text="CONNECTED"
                                       Foreground="#A5E8C7" FontSize="9" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Received folder" Click="OpenReceiveFolder_Click" Padding="13,9" Margin="0,0,9,0"/>
                    <Button Content="Disconnect" Click="Disconnect_Click" Background="#2B1821"
                            BorderBrush="#71323E" Foreground="#FF9CA3" Padding="14,9"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#101620" BorderBrush="#293447"
                    BorderThickness="1" CornerRadius="20" Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="6" Opacity="0.2"/>
                </Border.Effect>
                <ListBox x:Name="ChatList" ItemsSource="{Binding ChatMessages}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border x:Name="TextBubble" HorizontalAlignment="Left" MaxWidth="820"
                                        Background="#192331" BorderBrush="#2E3B4E" BorderThickness="1"
                                        CornerRadius="15,15,15,4" Padding="15,12">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Sender}" Foreground="#FF858B"
                                                       FontSize="9" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding SentAt, StringFormat={}{0:HH:mm}}"
                                                       Foreground="#77859A" FontSize="9" DockPanel.Dock="Right"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Text}" Foreground="#EAF0F8"
                                                   FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="FileBubble" Visibility="Collapsed" HorizontalAlignment="Left"
                                        MaxWidth="650" Background="#151E2A" BorderBrush="#71404A"
                                        BorderThickness="1" CornerRadius="16" Padding="16">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="FILE TRANSFER" Foreground="#FF858B"
                                                       FontSize="9" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding SentAt, StringFormat={}{0:HH:mm}}"
                                                       Foreground="#77859A" FontSize="9" DockPanel.Dock="Right"/>
                                        </DockPanel>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="42" Height="46" CornerRadius="12" Background="#2B202A"
                                                    BorderBrush="#82434D" BorderThickness="1" VerticalAlignment="Center">
                                                <TextBlock Text="⇅" FontSize="23" Foreground="#FF9AA0"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0">
                                                <TextBlock Text="{Binding FileName}" Foreground="#F5F7FB"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FileSizeLabel}" Foreground="#91A0B4"
                                                           FontSize="10" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progress}"
                                                     Background="#303B4D" Foreground="#F0525D"
                                                     BorderThickness="0" Margin="0,14,0,0"/>
                                        <TextBlock Text="{Binding TransferStatus}" Foreground="#A8B4C4"
                                                   FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        <Button Content="Open file" Tag="{Binding FilePath}" Click="OpenChatFile_Click"
                                                HorizontalAlignment="Left" Background="#202B3C" BorderBrush="#3C4A5E"
                                                Padding="12,7" Margin="0,11,0,0">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanOpenFile}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                    <Setter TargetName="TextBubble" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="TextBubble" Property="Background" Value="#2A1922"/>
                                    <Setter TargetName="TextBubble" Property="BorderBrush" Value="#71313D"/>
                                    <Setter TargetName="FileBubble" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="FileBubble" Property="Background" Value="#211B26"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFile}" Value="True">
                                    <Setter TargetName="TextBubble" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="FileBubble" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <Border Grid.Row="2" Background="#111823" BorderBrush="#2B374A"
                    BorderThickness="1" CornerRadius="18" Padding="10" Margin="0,13,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="ChatInput" Grid.Column="0" MinHeight="68" MaxHeight="92"
                             VerticalAlignment="Center" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center"
                             KeyDown="ChatInput_KeyDown" ToolTip="Type a message. Press Ctrl+Enter to send."/>
                    <Button Grid.Column="1" Content="Send" Click="SendChat_Click"
                            Background="#29364A" BorderBrush="#46556C" Padding="23,17" Margin="10,0,0,0"/>
                    <Button Grid.Column="2" Content="＋  Add files" Click="AddFiles_Click"
                            Background="#F0525D" BorderBrush="#F0525D" Padding="23,17"
                            FontSize="13" Margin="10,0,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="5,7,5,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready · Start LocalDrop to generate your connection QR."
                       Foreground="#78869B" FontSize="9" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="HADOC  /  KyZer_HADOC"
                       Foreground="#56647A" FontSize="9" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>