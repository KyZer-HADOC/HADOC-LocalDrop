<Window x:Class="HADOC.LocalDrop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HADOC LocalDrop" Height="790" Width="1180"
        MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="#0B0E14" Foreground="#F3F6FA"
        Closing="Window_Closing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="4,0,4,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="13" Background="#E5484D" Margin="0,0,14,0">
                    <TextBlock Text="LD" FontSize="20" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="HADOC LocalDrop" FontSize="23" FontWeight="Bold"/>
                    <TextBlock Text="ULTRA FAST  ·  PC ↔ MOBILE  ·  LOCAL NETWORK"
                               FontSize="10" Foreground="#9AA7B8" Margin="1,3,0,0"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="#17251F" BorderBrush="#28513A"
                    BorderThickness="1" CornerRadius="18" Padding="13,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#42D392" Margin="0,0,8,0"/>
                    <TextBlock Text="LOCAL &amp; PRIVATE" Foreground="#9BE5BF" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.88*"/><ColumnDefinition Width="1.12*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#141923" BorderBrush="#273244" BorderThickness="1"
                    CornerRadius="18" Padding="22" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="CONNECT DEVICE" FontSize="12" FontWeight="Bold" Foreground="#F06A70"/>
                        <TextBlock Text="Scan this QR code with your phone camera" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock Text="Phone and PC must be on the same Wi-Fi or hotspot network."
                                   Foreground="#9AA7B8" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="15" Padding="12"
                            HorizontalAlignment="Center" Margin="0,20,0,16">
                        <Grid Width="224" Height="224">
                            <Image x:Name="QrImage" Stretch="Uniform"/>
                            <StackPanel x:Name="QrPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" Width="190">
                                <TextBlock Text="QR" FontSize="46" FontWeight="Bold" Foreground="#D9DEE6" HorizontalAlignment="Center"/>
                                <TextBlock Text="Start the server to generate your connection QR"
                                           Foreground="#8993A3" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="NETWORK ADDRESS" Foreground="#9AA7B8" FontSize="10" FontWeight="Bold" Margin="0,0,0,7"/>
                        <ComboBox x:Name="AddressBox" Height="38" FontSize="13" Background="#0D121B"
                                  Foreground="#F3F6FA" BorderBrush="#344256" Padding="6"
                                  SelectionChanged="AddressBox_SelectionChanged"/>
                        <TextBlock x:Name="UrlText" Text="Start LocalDrop to create a QR connection"
                                   Foreground="#AAB6C6" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0"/>
                        <Button Content="Copy connection link" Click="CopyLink_Click"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Padding="11,7" FontSize="11"/>
                        <Border Background="#0D211B" BorderBrush="#24553C" BorderThickness="1"
                                CornerRadius="10" Padding="12" Margin="0,15,0,0">
                            <StackPanel>
                                <TextBlock Text="CONNECTED DEVICE" Foreground="#78D8A8" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="DeviceStatusText" Text="No phone connected"
                                           FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Button x:Name="StartStopButton" Grid.Row="3" Content="Start LocalDrop"
                            Click="StartStop_Click" Background="#E5484D" BorderBrush="#E5484D"
                            Padding="16,13" FontSize="14" Margin="0,20,0,0"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="#141923" BorderBrush="#273244" BorderThickness="1"
                    CornerRadius="18" Padding="18" Margin="10,0,0,0">
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabItem Header="SHARE FILES">
                        <Grid Margin="4,12,4,4">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Files shared from this PC" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Add files here. They will appear in the phone browser after pairing."
                                           Foreground="#9AA7B8" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                            <ListBox x:Name="FilesList" Grid.Row="1" ItemsSource="{Binding SharedFiles}" DisplayMemberPath="DisplayName"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="Remove selected" Click="RemoveFile_Click" Margin="0,0,8,0"/>
                                <Button Content="+ Add files" Click="AddFiles_Click" Background="#E5484D" BorderBrush="#E5484D"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="CHAT">
                        <Grid Margin="4,12,4,4">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Your connected phone" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Messages are sent only across the local connection."
                                           Foreground="#9AA7B8" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                            <ListBox x:Name="ChatList" Grid.Row="1" ItemsSource="{Binding ChatMessages}" DisplayMemberPath="DisplayText"/>
                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ChatInput" Height="40" VerticalContentAlignment="Center"
                                         KeyDown="ChatInput_KeyDown" ToolTip="Write a message"/>
                                <Button Grid.Column="1" Content="Send" Click="SendChat_Click"
                                        Background="#E5484D" BorderBrush="#E5484D" Margin="8,0,0,0"/>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="5,10,5,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready. Start LocalDrop to connect a phone."
                       Foreground="#9AA7B8" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="HADOC  ·  KyZer_HADOC" Foreground="#637185" FontSize="10" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
